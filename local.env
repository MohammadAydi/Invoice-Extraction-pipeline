# Surya detection settings tuned for the handwritten Arabic invoice form.
# Surya finds this file automatically via find_dotenv("local.env") — no
# activation needed. Keep it next to the scripts in D:\OCR.

TORCH_DEVICE=cpu

# Default 96 is too coarse for the short isolated digits in the Quantity
# column (16, 6) which were missed in every run. More pixels per glyph.
IMAGE_DPI=180

# Default 0.6. Lowered so faint, short pen strokes still register as text.
DETECTOR_TEXT_THRESHOLD=0.40

# Default 0.35. Widens the "maybe text" band beneath the threshold above.
DETECTOR_BLANK_THRESHOLD=0.20

# Default 0.05. Arabic has dots and tails above/below the baseline; a tight
# box clips them and the crop loses part of the letter.
DETECTOR_BOX_Y_EXPAND_MARGIN=0.12

# CPU defaults are 2 / 8. Raise only if RAM allows; lower if it swaps.
DETECTOR_BATCH_SIZE=2
RECOGNITION_BATCH_SIZE=8